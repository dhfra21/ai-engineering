# The Librarian as a systemd service on a Linux VM (deploy/DEPLOY.md, "Any Linux VM").
# Install: sudo cp deploy/librarian.service /etc/systemd/system/ && sudo systemctl daemon-reload
#          && sudo systemctl enable --now librarian
# Assumes the repo is cloned in /home/azureuser/ai-engineering and .env holds OPENAI_API_KEY and ADMIN_TOKEN.
[Unit]
Description=The Librarian: Tunisian law Q&A (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
User=azureuser
WorkingDirectory=/home/azureuser/ai-engineering/project2-librarian
EnvironmentFile=/home/azureuser/ai-engineering/project2-librarian/.env
Environment=INDEX=article-oai LOG_DIR=/home/azureuser/librarian-logs
ExecStart=/home/azureuser/ai-engineering/project2-librarian/.venv/bin/uvicorn src.service:app --host 0.0.0.0 --port 80
# lets a non-root user listen on port 80
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
